# Hosted values are configured through the site's runtime settings.
MODERATION_OWNER_EMAIL=
# Enables Google Search AI Overviews when available for a question.
SERPAPI_API_KEY=
# Optional Google-generated summaries based on screened articles.
GEMINI_API_KEY=
# Optional server-side outbound mail. The sender must be verified with Resend.
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=

# Enables YouTube-wide search. Without it, the player searches public channel feeds.
YOUTUBE_API_KEY=
